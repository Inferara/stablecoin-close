{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Inferara/stablecoin-close/blob/main/registry/stellar-rwa.schema.json",
  "title": "stellar-rwa-registry/1",
  "description": "Open registry of tokenised real-world assets on Stellar and where a real value for each comes from. See registry/README.md.",
  "type": "object",
  "required": [
    "format",
    "checked",
    "oracles",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "stellar-rwa-registry/1"
    },
    "checked": {
      "$ref": "#/$defs/date",
      "description": "When identifiers and sources were last checked against primary sources."
    },
    "oracles": {
      "type": "object",
      "description": "The on-chain price contracts the sources refer to, by source kind.",
      "propertyNames": {
        "enum": [
          "redstone_sep40",
          "redstone_feed",
          "chainlink"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "network",
          "decimals",
          "base",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "network": {
            "$ref": "#/$defs/network"
          },
          "contract": {
            "$ref": "#/$defs/contractId"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 38
          },
          "base": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "stale_after_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "network": {
      "enum": [
        "mainnet",
        "testnet"
      ]
    },
    "accountId": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^C[A-Z2-7]{55}$"
    },
    "assetCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,12}$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "issuer_name",
        "home_domain",
        "network",
        "code",
        "issuer",
        "contract",
        "token",
        "decimals",
        "class",
        "valuation",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "issuer_name": {
          "type": "string",
          "minLength": 1
        },
        "home_domain": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "code": {
          "$ref": "#/$defs/assetCode"
        },
        "issuer": {
          "description": "The classic issuing account; null for a Soroban-only token.",
          "oneOf": [
            {
              "$ref": "#/$defs/accountId"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract": {
          "$ref": "#/$defs/contractId",
          "description": "The SAC of a classic asset, or the token contract of a Soroban token."
        },
        "token": {
          "enum": [
            "classic",
            "soroban"
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "class": {
          "enum": [
            "fund_share",
            "bond",
            "commodity",
            "stablecoin"
          ]
        },
        "valuation": {
          "enum": [
            "nav",
            "fixed_nav",
            "market",
            "par"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "description": "Tried in order until one gives a value for the moment asked.",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "price_as": {
          "type": "string",
          "description": "On a testnet entry: the id of the mainnet entry it is priced as."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "token": {
                "const": "classic"
              }
            }
          },
          "then": {
            "properties": {
              "issuer": {
                "$ref": "#/$defs/accountId"
              }
            }
          },
          "else": {
            "properties": {
              "issuer": {
                "type": "null"
              }
            }
          }
        },
        {
          "description": "An entry either has its own sources or is priced as another entry, not both.",
          "oneOf": [
            {
              "required": [
                "sources"
              ],
              "not": {
                "required": [
                  "price_as"
                ]
              }
            },
            {
              "required": [
                "price_as"
              ],
              "not": {
                "required": [
                  "sources"
                ]
              },
              "properties": {
                "network": {
                  "const": "testnet"
                }
              }
            }
          ]
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "value": {
              "$ref": "#/$defs/decimalString"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "redstone_sep40"
            },
            "asset": {
              "$ref": "#/$defs/contractId"
            }
          },
          "required": [
            "asset"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "redstone_feed"
            },
            "contract": {
              "$ref": "#/$defs/contractId"
            }
          },
          "required": [
            "contract"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "chainlink"
            },
            "data_id": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          },
          "required": [
            "data_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "coingecko"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "rumblefish"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
